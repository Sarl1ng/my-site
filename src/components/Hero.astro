---
import LeadForm from "./LeadForm.astro";

const city = "Новороссийске";
---

<section class="relative text-white">
  {/* background */}
  <div
    class="absolute inset-0 bg-center bg-cover"
    style="background-image:url(/assets/img/hero.webp);"
    aria-hidden="true"
  ></div>
  {/* overlay */}
  <div class="absolute inset-0 bg-black/60" aria-hidden="true"></div>

  <div class="relative mx-auto w-[min(1200px,100%-32px)] py-12 md:py-20">
    <div class="grid gap-8 items-start lg:grid-cols-2 min-h-[520px]">
      {/* left */}
      <div>
        <h1 class="font-extrabold leading-[1.05] text-[clamp(34px,4.4vw,56px)]">
          Заказ прочистки канализации<br /> в {city}
        </h1>


        <p class="mt-4 font-semibold text-red-500">
          Перезвоним в течение 5 минут
        </p>

        <LeadForm />
      </div>

      {/* right card */}
      <aside class="rounded-2xl border border-white/60 bg-black/30 p-6 backdrop-blur
                    lg:justify-self-end lg:w-[520px]">
        <ul class="grid gap-5">
          <li class="grid grid-cols-[42px_1fr] gap-3 items-center">
            <span class="text-red-500 text-2xl">🚚</span>
            <span class="text-2xl font-extrabold leading-tight">Бесплатный выезд</span>
          </li>
          <li class="grid grid-cols-[42px_1fr] gap-3 items-center">
            <span class="text-red-500 text-2xl">⏱️</span>
            <span class="text-2xl font-extrabold leading-tight">Приезд в течение часа</span>
          </li>
          <li class="grid grid-cols-[42px_1fr] gap-3 items-center">
            <span class="text-red-500 text-2xl">✅</span>
            <span class="text-2xl font-extrabold leading-tight">Гарантия до 5 лет</span>
          </li>
          <li class="grid grid-cols-[42px_1fr] gap-3 items-center">
            <span class="text-red-500 text-2xl">🛡️</span>
            <span class="text-2xl font-extrabold leading-tight">Мастера в специальной форме</span>
          </li>
        </ul>
      </aside>
    </div>
  </div>

  {/* optional divider */}
  <div class="relative h-14 bg-white/10" aria-hidden="true"></div>
</section>
