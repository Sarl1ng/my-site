---
const WA = "https://wa.me/79385381577"; // номер WhatsApp с сайта
const TEL = "tel:+79042881188";
---
<div class="float">
  <a class="bubble bubble--wa" href={WA} target="_blank" rel="noreferrer" aria-label="WhatsApp">
    <span>WA</span>
  </a>
  <a class="bubble bubble--tel" href={TEL} aria-label="Позвонить">
    <span>📞</span>
  </a>
</div>

<style>
.float{
  position: fixed;
  right: 22px;
  top: 40%;
  display:flex;
  flex-direction:column;
  gap: 18px;
  z-index: 50;
}
.bubble{
  width: 74px; height: 74px;
  border-radius: 999px;
  display:grid;
  place-items:center;
  font-weight: 900;
  text-decoration:none;
  box-shadow: 0 10px 26px rgba(0,0,0,.25);
  border: 6px solid #fff;
}
.bubble--wa{ background:#25D366; color:#fff; }
.bubble--tel{ background:#00ff3b; color:#111; font-size: 28px; }
</style>
