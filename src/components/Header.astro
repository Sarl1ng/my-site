---
import { nav, type NavItem } from "../data/nav";

type Props = {
  activePath?: string;
  phone?: string;
  phoneHref?: string;
  tagline?: string;
  logoSrc?: string;
  logoAlt?: string;
};

const {
  activePath = "",
  phone = "+7 (904) 288-11-88",
  phoneHref = "tel:+79042881188",
  tagline = "Сантехнические работы и услуги по прочистке канализации любой сложности в Краснодарском крае",
  logoSrc = "/assets/img/logo.png",
  logoAlt = "Логотип",
} = Astro.props;

function isActive(item: NavItem, path: string) {
  if (!path) return false;
  if (item.href === "/" && path === "/") return true;
  if (item.href !== "/" && path.startsWith(item.href)) return true;

  if (item.label === "Услуги") {
    const roots = [
      "/ustranenie-zasorov/",
      "/prochistka-kanalizaczii/",
      "/gidrodinamicheskaya-ochistka-kanalizaczii/",
      "/mehanicheskaya-prochistka-kanalizaczii/",
      "/prochistka-livnevoj-kanalizaczii/",
      "/elektromehanicheskaya-prochistka-kanalizaczii/",
      "/prochistka-unitaza/",
      "/ustanovka-santehniki/",
      "/ustanovka-rakoviny/",
      "/ustanovka-smesitelya/",
      "/ustanovka-vanny/",
      "/ustanovka-unitaza/",
      "/ustanovka-dushevoj-kabiny/",
      "/ustanovka-schetchikov-vody/",
      "/ustanovka-vodonagrevatelya/",
      "/zamena-trub/",
      "/zamena-kanalizaczionnyh-trub/",
      "/zamena-vodyanyh-trub-hvs-gvs/",
      "/zamena-stoyakov/",
      "/zamena-radiatorov/",
      "/zamena-trub-otopleniya/",
    ];
    if (roots.some((p) => path.startsWith(p))) return true;
  }

  return false;
}
---

<!-- ✅ Sticky ТОЛЬКО белая полоса -->
<div class="bg-white sticky top-0 z-50">
  <div class="site-container">
    <div class="flex items-center justify-between gap-4 py-3">
      <a href="/" class="shrink-0">
        <img src={logoSrc} alt={logoAlt} class="h-10 w-auto md:h-12" loading="eager" />
      </a>

      <p class="hidden lg:block flex-1 text-center text-sm text-neutral-700">
        {tagline}
      </p>

      <div class="flex items-center gap-4 shrink-0">
        <a href={phoneHref} class="btn btn-outline whitespace-nowrap">
          Позвоните нам
        </a>

        <div class="hidden lg:flex items-center gap-3">
          <span class="inline-flex h-9 w-9 items-center justify-center text-[#F83C0F]" aria-hidden="true">
            <svg viewBox="0 0 512 512" class="h-5 w-5 fill-current">
              <path d="M497.39 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.66 370.66 0 0 1 130.6 204.11l60.6-49.6a23.94 23.94 0 0 0 6.9-28l-48-112A24.16 24.16 0 0 0 122.6.61l-104 24A24 24 0 0 0 0 48c0 256.5 207.9 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.29 24.29 0 0 0-14.01-27.6z"></path>
            </svg>
          </span>

          <div class="leading-tight">
            <a href={phoneHref} class="block text-lg font-semibold text-neutral-900">
              {phone}
            </a>
            <div class="text-sm text-neutral-700">
              Работаем 24/7 в выходные и праздники
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ✅ Синяя полоса НЕ sticky (обычный flow) -->
<header class="relative z-40">
  <div class="nav-blue h-[46px]">
    <div class="site-container h-full">
      <nav class="hidden md:flex h-full items-stretch justify-center" aria-label="Меню">
        <ul class="flex h-full items-stretch">
          {nav.map((item) => (
            <li class="relative group">
              <a
                href={item.href}
                class={[
                  "flex items-center h-[46px] px-[50px] py-[13px]",
                  "text-[16px] font-semibold leading-5 text-white no-underline",
                  "transition-all duration-400 ease-in-out",
                  isActive(item, activePath) ? "nav-active" : "hover:bg-white/15",
                ].join(" ")}
              >
                {item.label}
                {item.children && (
                  <span class="ml-2 inline-flex" aria-hidden="true">
                    <svg viewBox="0 0 320 512" class="h-4 w-4 fill-current">
                      <path d="M31.3 192h257.3c17.8 0 26.7 21.5 14.1 34.1L174.1 354.8c-7.8 7.8-20.5 7.8-28.3 0L17.2 226.1C4.6 213.5 13.5 192 31.3 192z"></path>
                    </svg>
                  </span>
                )}
              </a>

              {item.children && (
                <ul
                  class="invisible opacity-0 group-hover:visible group-hover:opacity-100
                         absolute left-0 top-full z-50
                         min-w-[260px] rounded-2xl bg-white shadow-lg
                         py-2 transition-all duration-200"
                >
                  {item.children.map((child) => (
                    <li class="relative group/sub">
                      <a
                        href={child.href}
                        class="flex items-center justify-between gap-3 px-4 py-2 text-sm text-neutral-900 hover:bg-neutral-100"
                      >
                        <span class="line-clamp-2">{child.label}</span>
                        {child.children && <span class="ml-2 text-neutral-500" aria-hidden="true">›</span>}
                      </a>

                      {child.children && (
                        <ul
                          class="invisible opacity-0 group-hover/sub:visible group-hover/sub:opacity-100
                                 absolute left-full top-0 z-50
                                 min-w-[320px] rounded-2xl bg-white shadow-lg
                                 py-2 transition-all duration-200"
                        >
                          {child.children.map((leaf) => (
                            <li>
                              <a href={leaf.href} class="block px-4 py-2 text-sm text-neutral-900 hover:bg-neutral-100">
                                {leaf.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:hidden h-full flex items-center justify-end">
        <details class="relative">
          <summary
            class="list-none cursor-pointer select-none inline-flex items-center justify-center
                   h-10 w-10 rounded-lg bg-white/20 text-white"
            aria-label="Открыть меню"
          >
            <svg viewBox="0 0 1000 1000" class="h-6 w-6 fill-current" aria-hidden="true">
              <path d="M104 333H896C929 333 958 304 958 271S929 208 896 208H104C71 208 42 237 42 271S71 333 104 333ZM104 583H896C929 583 958 554 958 521S929 458 896 458H104C71 458 42 487 42 521S71 583 104 583ZM104 833H896C929 833 958 804 958 771S929 708 896 708H104C71 708 42 737 42 771S71 833 104 833Z"></path>
            </svg>
          </summary>

          <div class="absolute right-0 top-[calc(100%+8px)] z-50 w-[min(92vw,420px)] rounded-2xl bg-white shadow-xl overflow-hidden">
            <nav aria-label="Мобильное меню">
              <ul class="py-2">
                {nav.map((item) => (
                  <li class="border-b border-neutral-100 last:border-b-0">
                    {item.children ? (
                      <details>
                        <summary class="list-none cursor-pointer px-4 py-3 flex items-center justify-between text-neutral-900 font-semibold">
                          <span>{item.label}</span>
                          <span aria-hidden="true">▾</span>
                        </summary>
                        <div class="pb-2">
                          {item.children.map((child) => (
                            <div class="px-4">
                              {child.children ? (
                                <details class="py-1">
                                  <summary class="list-none cursor-pointer flex items-center justify-between py-2 text-sm font-semibold text-neutral-900">
                                    <span class="pr-3">{child.label}</span>
                                    <span aria-hidden="true">▾</span>
                                  </summary>
                                  <div class="pb-2">
                                    {child.children.map((leaf) => (
                                      <a href={leaf.href} class="block py-2 pl-3 text-sm text-neutral-700 hover:text-neutral-900">
                                        {leaf.label}
                                      </a>
                                    ))}
                                  </div>
                                </details>
                              ) : (
                                <a href={child.href} class="block py-2 text-sm text-neutral-700 hover:text-neutral-900">
                                  {child.label}
                                </a>
                              )}
                            </div>
                          ))}
                        </div>
                      </details>
                    ) : (
                      <a href={item.href} class="block px-4 py-3 text-neutral-900 font-semibold">
                        {item.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
