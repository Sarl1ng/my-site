---
import { services } from "../../data/services";
import { priceCategories } from "../../data/prices";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";

const popular = priceCategories[0].items;
---

<section class="section" id="popular-services">
  <Container>
    <SectionTitle title="Популярные услуги прочистки" />
    <div class="cards cards--popular">
      {popular.map((item) => (
        <article class="service-card service-card--photo">
          {item.image && <img src={item.image} alt={item.alt ?? item.title} loading="lazy" width="300" height="200" />}
          <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
          <p>{item.price}</p>
          <Button href={item.href ?? "#lead-form"} variant="primary">Оставить заявку</Button>
        </article>
      ))}
    </div>

    <SectionTitle title="Услуги прочистки" />
    <div class="service-list">
      {services.map((service) => (
        <a href={`/${service.slug}/`} class="service-list__item">
          <span>{service.icon}</span>
          <strong>{service.title}</strong>
        </a>
      ))}
    </div>
  </Container>
</section>
