---
import { priceCategories } from "../../data/prices";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
---

<section class="section section--white">
  <Container>
    <SectionTitle title="Цены на популярные услуги" description="Использованы только стартовые цены, найденные в старом сайте/скриншотах. Остальное оставлено как TODO." />
    <div class="price-grid">
      {priceCategories[0].items.map((item) => (
        <article class="price-card">
          <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
          <p>{item.price}</p>
          <span>Источник: старый сайт</span>
        </article>
      ))}
    </div>
    <div class="section-action">
      <Button href="/czeny/" variant="outline">Смотреть все цены</Button>
    </div>
  </Container>
</section>
