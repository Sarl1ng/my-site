---
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
---

<section class="section" id="lead-form">
  <Container class="lead-section">
    <SectionTitle align="left" title="Оставить заявку" description="Опишите задачу, и мастер свяжется с вами. Форма пока статическая: обработчик заявки нужно подключить отдельно." />
    <form class="lead-form" action="#" method="post">
      <label>
        Имя
        <input name="name" type="text" placeholder="Как к вам обращаться" autocomplete="name" />
      </label>
      <label>
        Телефон
        <input name="phone" type="tel" placeholder="+7 (___) ___-__-__" autocomplete="tel" required />
      </label>
      <label>
        Что случилось
        <textarea name="message" rows="4" placeholder="Например: засорилась канализация, нужна прочистка"></textarea>
      </label>
      <button type="submit">Вызвать мастера</button>
      <p>TODO: добавить endpoint, антиспам и текст согласия на обработку персональных данных.</p>
    </form>
  </Container>
</section>
