---
import { site } from "../../data/site";
import Container from "../ui/Container.astro";
---

<div class="hero-breadcrumb" aria-label="Хлебные крошки">
  <Container>
    <span>Главная страница</span>
  </Container>
</div>

<section class="hero" style="background-image: url('/images/home/hero-santekhnika.webp');">
  <Container class="hero__inner">
    <div class="hero__content">
      <h1>Заказ прочистки канализации в Новороссийске</h1>
      <h3>Перезвоним в течение 5 минут</h3>
      <form class="inline-form" action="#" method="post">
        <label class="sr-only" for="hero-phone">Телефон</label>
        <input
          id="hero-phone"
          name="phone"
          type="tel"
          placeholder="Введите ваш телефон"
          autocomplete="tel"
          pattern="[0-9()#+*-=.]+"
          title="Принимаются только цифры и телефонные символы (#, -, * и т. д.)."
        />
        <button type="submit">Вызвать мастера</button>
      </form>
      <a class="hero__mobile-call" href={site.phoneHref}>Вызвать мастера</a>
    </div>
    <aside class="hero__card" aria-label="Преимущества вызова">
      <ul>
        <li>
          <svg viewBox="0 0 512 512" aria-hidden="true">
            <circle cx="384.533" cy="415.6" r="48.2"></circle>
            <circle cx="111.4" cy="415.6" r="48.2" transform="rotate(-54.2 111.51 415.74)"></circle>
