---
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";

const advantages = [
  ["📋", "Мастера с многолетним опытом", "Формулировка взята со старого сайта; точные годы опыта нужно подтвердить."],
  ["💳", "Оплата удобным способом", "На старом сайте указана оплата любым удобным способом."],
  ["🧮", "Цена доступна до работ", "Стоимость должна согласовываться с клиентом до начала работ."],
  ["🚚", "Выезд мастера", "Старый сайт делает акцент на оперативном выезде."],
  ["🌐", "Работаем по региону", "Новороссийск и Краснодарский край. Точные районы: TODO."],
  ["🛡", "Гарантия: TODO", "Старый сайт заявлял гарантию, но условия нужно подтвердить."],
];
---

<section class="section section--white">
  <Container>
    <SectionTitle title="Заказ прочистки канализации 24 часа в Новороссийске и области!" />
    <div class="advantages">
      {advantages.map(([icon, title, text]) => (
        <article>
          <span>{icon}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
