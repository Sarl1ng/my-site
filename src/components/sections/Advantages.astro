---
import Container from "../ui/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";

const advantages = [
  ["🧾", "Понятная заявка", "Принимаем обращение и уточняем задачу до выезда."],
  ["🚚", "Выезд мастера", "Старый сайт делал акцент на оперативном приезде мастера."],
  ["🧰", "Разные типы работ", "Прочистка, сантехника, замена труб и аварийные задачи."],
  ["📍", "Регион сайта", "Новороссийск и Краснодарский край. Зоны выезда нужно подтвердить."],
  ["🛡", "Условия работ", "Гарантии и сроки оставлены как TODO до подтверждения владельцем."],
  ["☎", "Видимый телефон", "Телефон и CTA доступны в шапке, первом экране и плавающих кнопках."],
];
---

<section class="section section--white">
  <Container>
    <SectionTitle title="Заказ прочистки канализации 24 часа в Новороссийске и области" description="Блок повторяет коммерческую роль старого сайта, но без неподтвержденных обещаний." />
    <div class="advantages">
      {advantages.map(([icon, title, text]) => (
        <article>
          <span>{icon}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </Container>
</section>
