---
import { nav, type NavItem } from "../../data/nav";
import { site } from "../../data/site";
import Container from "../ui/Container.astro";

type Props = {
  activePath?: string;
};

const { activePath = "" } = Astro.props;
const headerNav = nav.filter((item) => item.href !== "/kontakty/");

function isActive(item: NavItem) {
  if (item.href === "/" && activePath === "/") return true;
  if (item.label === "Услуги" && activePath === "/") return true;
  if (item.href !== "/" && activePath.startsWith(item.href)) return true;
  return item.children?.some((child) => isActive(child)) ?? false;
}
---

<header class="site-header">
  <div class="site-header__top">
    <Container class="site-header__top-inner">
      <a class="site-header__logo" href="/" aria-label="На главную">
        <img src={site.logo.src} alt={site.logo.alt} width="150" height="95" loading="eager" />
      </a>
      <p class="site-header__tagline">{site.tagline}</p>
      <div class="site-header__call-wrap">
        <a class="site-header__call" href={site.phoneHref}>Позвоните<br />нам</a>
      </div>
      <div class="site-header__contacts">
        <div class="site-header__phone">
          <div class="site-header__phone-line">
            <svg viewBox="0 0 512 512" aria-hidden="true">
              <path d="M497.39 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.66 370.66 0 0 1 130.6 204.11l60.6-49.6a23.94 23.94 0 0 0 6.9-28l-48-112A24.16 24.16 0 0 0 122.6.61l-104 24A24 24 0 0 0 0 48c0 256.5 207.9 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.29 24.29 0 0 0-14.01-27.6z"></path>
            </svg>
            <a href={site.phoneHref}>{site.phone}</a>
          </div>
          <span>Работаем 24/7 в выходные и праздники</span>
        </div>
      </div>
    </Container>
  </div>

  <div class="site-header__nav">
    <Container>
      <nav class="desktop-nav" aria-label="Главное меню">
        {headerNav.map((item) => (
          <div class="desktop-nav__item">
            <a class:list={["desktop-nav__link", { "is-active": isActive(item) }]} href={item.href}>
              {item.label}
              {item.children && (
                <svg class="desktop-nav__caret" viewBox="0 0 320 512" aria-hidden="true">
                  <path d="M31.3 192h257.3c17.8 0 26.7 21.5 14.1 34.1L174.1 354.8c-7.8 7.8-20.5 7.8-28.3 0L17.2 226.1C4.6 213.5 13.5 192 31.3 192z"></path>
                </svg>
              )}
            </a>
            {item.children && (
              <div class="desktop-nav__dropdown">
                {item.children.map((group) => (
                  <div>
                    <a class="desktop-nav__group" href={group.href}>{group.label}</a>
                    {group.children?.map((child) => (
                      <a href={child.href}>{child.label}</a>
                    ))}
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>

      <details class="mobile-nav">
        <summary aria-label="Переключатель меню">
          <svg class="mobile-nav__icon mobile-nav__icon--open" viewBox="0 0 1000 1000" aria-hidden="true">
            <path d="M104 333H896C929 333 958 304 958 271S929 208 896 208H104C71 208 42 237 42 271S71 333 104 333ZM104 583H896C929 583 958 554 958 521S929 458 896 458H104C71 458 42 487 42 521S71 583 104 583ZM104 833H896C929 833 958 804 958 771S929 708 896 708H104C71 708 42 737 42 771S71 833 104 833Z"></path>
          </svg>
          <svg class="mobile-nav__icon mobile-nav__icon--close" viewBox="0 0 1000 1000" aria-hidden="true">
            <path d="M742 167L500 408 258 167C246 154 233 150 217 150 196 150 179 158 167 167 154 179 150 196 150 212 150 229 154 242 171 254L408 500 167 742C138 771 138 800 167 829 196 858 225 858 254 829L496 587 738 829C750 842 767 846 783 846 800 846 817 842 829 829 842 817 846 804 846 783 846 767 842 750 829 737L588 500 833 258C863 229 863 200 833 171 804 137 775 137 742 167Z"></path>
          </svg>
        </summary>
        <nav aria-label="Мобильное меню">
          {headerNav.map((item) => (
            <details open={isActive(item)}>
              <summary><a href={item.href}>{item.label}</a></summary>
              {item.children?.map((group) => (
                <div class="mobile-nav__group">
                  <a href={group.href}>{group.label}</a>
                  {group.children?.map((child) => <a href={child.href}>{child.label}</a>)}
                </div>
              ))}
            </details>
          ))}
        </nav>
      </details>
    </Container>
  </div>
</header>
