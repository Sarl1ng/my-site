---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import Container from "../../components/ui/Container.astro";
import LeadForm from "../../components/sections/LeadForm.astro";
import { site } from "../../data/site";
---

<BaseLayout
  title="Контакты PRO Сервис | Новороссийск"
  description="Телефон, почта, адрес и режим работы сервиса прочистки канализации и сантехнических работ в Новороссийске."
  canonical="/kontakty/"
>
  <Container class="page-head">
    <Breadcrumbs items={[{ label: "Контакты" }]} />
    <h1>Контакты</h1>
    <p>Свяжитесь с мастером по телефону или оставьте заявку. Данные взяты из старого сайта и требуют финального подтверждения.</p>
  </Container>

  <section class="section section--white">
    <Container class="contacts-preview__grid">
      <article>
        <h2>Телефон</h2>
        <a href={site.phoneHref}>{site.phone}</a>
      </article>
      <article>
        <h2>Почта</h2>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </article>
      <article>
        <h2>Адрес</h2>
        <p>{site.address}</p>
      </article>
      <article>
        <h2>Режим работы</h2>
        <p>{site.workingHours}</p>
      </article>
    </Container>
  </section>

  <LeadForm />
</BaseLayout>
